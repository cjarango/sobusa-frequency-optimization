        "duracion_min":    "Duración (min)",
        "idprogramacion":  "ID programación",
        "idvehiculo":      "Vehículo",
    })
)

tabla_final["Duración (min)"] = tabla_final["Duración (min)"].round(1)

_ = toolkit.dataframe_head_table(tabla_final, n=10)

df_prog = df_prog[
