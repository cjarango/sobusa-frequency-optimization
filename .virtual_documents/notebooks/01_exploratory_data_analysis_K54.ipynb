UMBRAL        = 250
UMBRAL_BUG    = 10000
fecha_anomala = pd.Timestamp("2024-09-06").date()

filtro1 = df_prog[df_prog["numeropasajeros"] > UMBRAL].copy()

filtro2 = filtro1[
    (filtro1["numeropasajeros"] < UMBRAL_BUG) &
